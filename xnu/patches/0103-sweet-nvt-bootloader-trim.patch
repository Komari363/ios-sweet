+bool
+SweetNovatekTouch::nvtBootloaderReset()
+{
+	/* Linux nvt_bootloader_reset(): SWRST_N8_ADDR=0x03F0FE, 0x69,
+	 * then disable SPI_RD_FAST at 0x03F310. */
+	if (!writeData(0x03f0feu, 0x69u)) {
+		IOLog("SWEET NVT: bootloader reset write failed\n");
+		return false;
+	}
+	IODelay(5000);
+	if (!writeData(0x03f310u, 0x00u)) {
+		IOLog("SWEET NVT: SPI_RD_FAST disable failed; continuing\n");
+	}
+	return true;
+}
+
+bool
+SweetNovatekTouch::readChipTrim()
+{
+	/* Linux nvt_ts_check_chip_ver_trim(): CTP_SPI_READ(buf, 7) means
+	 * command + 6 data bytes, total transfer 8. */
+	uint8_t trim[6] = { 0 };
+	if (!readData(0x03f004u, trim, sizeof(trim))) {
+		return false;
+	}
+	IOLog("SWEET NVT: chip trim %02x %02x %02x %02x %02x %02x\n",
+	    (unsigned)trim[0], (unsigned)trim[1], (unsigned)trim[2],
+	    (unsigned)trim[3], (unsigned)trim[4], (unsigned)trim[5]);
+	return true;
+}
