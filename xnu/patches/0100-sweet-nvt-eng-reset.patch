+
+bool
+SweetNovatekTouch::writeData(uint32_t addr, uint8_t value)
+{
+	if (!pageSet(addr)) {
+		return false;
+	}
+	uint8_t tx[2] = {
+		(uint8_t)(addr & 0x7f), value
+	};
+	return fSPI->spiTransfer(tx, NULL, sizeof(tx), NVT_SPI_HZ, 0, 0, 8) ==
+	    kIOReturnSuccess;
+}
+
+bool
+SweetNovatekTouch::nvtEngReset()
+{
+	/* Linux nvt_eng_reset(): write 0x5A to ENG_RST_ADDR (0x7FFF80)
+	 * before the 10 ms POR wait.  Without this the controller may stay
+	 * in its previous host-interface state and drive no MISO. */
+	if (!writeData(0x7fff80u, 0x5au)) {
+		IOLog("SWEET NVT: eng reset write failed\n");
+		return false;
+	}
+	IODelay(1000);
+	return true;
 }
 
