diff --git a/iokit/Kernel/arm/SweetNovatekTouch.cpp b/iokit/Kernel/arm/SweetNovatekTouch.cpp
new file mode 100644
index 0000000..0924796
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNovatekTouch.cpp
@@ -0,0 +1,304 @@
+/*
+ * NABU NT36523 touch provider over SweetGeniSPI.
+ *
+ * Normal touch uses the controller's existing firmware.  The 14-second
+ * firmware update attempt in the Linux driver is deliberately absent; only
+ * a future recovery path should download fw01/fw02.
+ *
+ * The A4.2 provider polls GPIO39 at 8 ms instead of registering the GIC SPI
+ * 583 interrupt.  The SPI packet path is identical to what an IRQ handler
+ * would run; switching to an interrupt source is a later increment.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+
+#include "SweetNovatekTouch.h"
+#include "SweetGeniSPI.h"
+#include "SweetPlatform.h"
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <pexpert/pexpert.h>
+
+#define NVT_EVENT_BUF            0x02fe00u
+#define NVT_EVENT_FWINFO         0x78u
+#define NVT_EVENT_RESET_STATE    0x60u
+#define NVT_EVENT_HANDSHAKE      0x51u
+#define NVT_SWRST_N8             0x03f0feu
+#define NVT_PACKET_LEN           65u
+#define NVT_MAX_FINGERS          10u
+#define NVT_IRQ_GPIO             39u
+#define NVT_VDDIO_GPIO           100u
+#define NVT_SPI_HZ               9600000u
+
+extern "C" void sweet_hid_touch(int finger, int down, int x, int y);
+
+OSDefineMetaClassAndStructors(SweetNovatekTouch, IOService);
+
+bool
+SweetNovatekTouch::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	int enable = 1;
+	PE_parse_boot_argn("sweetnovatek", &enable, sizeof(enable));
+	if (!enable) {
+		IOLog("SWEET NVT: disabled by sweetnovatek=0\n");
+		return false;
+	}
+	int forcePoll = 0;
+	PE_parse_boot_argn("sweetnovatek_poll", &forcePoll, sizeof(forcePoll));
+	fForcePoll = forcePoll != 0;
+	fSPI = NULL;
+	fTLMM = NULL;
+	fWorkLoop = NULL;
+	fTimer = NULL;
+	fLock = NULL;
+	fMaxX = 1600;
+	fMaxY = 2560;
+	fPackets = 0;
+	fErrors = 0;
+	fChecksumErrors = 0;
+	for (uint32_t i = 0; i < NVT_MAX_FINGERS; i++) {
+		fDown[i] = false;
+		fX[i] = 0;
+		fY[i] = 0;
+	}
+
+	fLock = IOLockAlloc();
+	if (fLock == NULL || !findProviders()) {
+		IOLog("SWEET NVT: SPI/TLMM provider missing\n");
+		return false;
+	}
+
+	/* VDDIO is a GPIO100 fixed regulator; ABL normally leaves it on, but
+	 * make the state explicit before the first SPI access. */
+	fTLMM->setMux(NVT_VDDIO_GPIO, 0);
+	fTLMM->setPad(NVT_VDDIO_GPIO, 0, 3, true);
+	fTLMM->gpioWrite(NVT_VDDIO_GPIO, true);
+	/* INT: GPIO input, pull-down; the controller drives it high. */
+	fTLMM->setMux(NVT_IRQ_GPIO, 0);
+	fTLMM->setPad(NVT_IRQ_GPIO, 1, 0, false);
+	IODelay(4000);
+
+	if (!readFwInfo()) {
+		IOLog("SWEET NVT: FWINFO read failed; continuing\n");
+	}
+
+	fWorkLoop = IOWorkLoop::workLoop();
+	fTimer = IOTimerEventSource::timerEventSource(this, &SweetNovatekTouch::pollFired);
+	if (fWorkLoop == NULL || fTimer == NULL ||
+	    fWorkLoop->addEventSource(fTimer) != kIOReturnSuccess) {
+		IOLog("SWEET NVT: cannot arm poll timer\n");
+		return false;
+	}
+	fTimer->setTimeoutMS(8);
+	registerService();
+	IOLog("SWEET NVT: ready, %ux%u, poll=%d int=%u\n",
+	    fMaxX, fMaxY, fForcePoll, fTLMM->gpioRead(NVT_IRQ_GPIO));
+	return true;
+}
+
+void
+SweetNovatekTouch::stop(IOService *provider)
+{
+	if (fTimer != NULL) {
+		fTimer->cancelTimeout();
+		if (fWorkLoop != NULL) {
+			fWorkLoop->removeEventSource(fTimer);
+		}
+		fTimer->release();
+		fTimer = NULL;
+	}
+	if (fWorkLoop != NULL) {
+		fWorkLoop->release();
+		fWorkLoop = NULL;
+	}
+	if (fSPI != NULL) {
+		fSPI->release();
+		fSPI = NULL;
+	}
+	if (fTLMM != NULL) {
+		fTLMM->release();
+		fTLMM = NULL;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOService::stop(provider);
+}
+
+bool
+SweetNovatekTouch::findProviders()
+{
+	OSPtr<OSDictionary> spiMatch = IOService::serviceMatching("SweetGeniSPI");
+	OSPtr<OSDictionary> tlmmMatch = IOService::serviceMatching("SweetTLMM");
+	if (spiMatch == NULL || tlmmMatch == NULL) {
+		return false;
+	}
+	OSPtr<IOService> spi = IOService::waitForMatchingService(spiMatch,
+	    5ULL * 1000000000ULL);
+	OSPtr<IOService> tlmm = IOService::waitForMatchingService(tlmmMatch,
+	    5ULL * 1000000000ULL);
+	fSPI = OSDynamicCast(SweetGeniSPI, spi);
+	fTLMM = OSDynamicCast(SweetTLMM, tlmm);
+	if (fSPI == NULL || fTLMM == NULL) {
+		return false;
+	}
+	fSPI->retain();
+	fTLMM->retain();
+	return true;
+}
+
+bool
+SweetNovatekTouch::pageSet(uint32_t addr)
+{
+	uint8_t tx[3] = {
+		0xff, (uint8_t)((addr >> 15) & 0xff), (uint8_t)((addr >> 7) & 0xff)
+	};
+	return fSPI->spiTransfer(tx, NULL, sizeof(tx), NVT_SPI_HZ, 0, 0, 8) ==
+	    kIOReturnSuccess;
+}
+
+bool
+SweetNovatekTouch::readData(uint32_t addr, uint8_t *buf, uint32_t len)
+{
+	if (len == 0 || len > 80 || buf == NULL || !pageSet(addr)) {
+		return false;
+	}
+	uint8_t tx[96] = { 0 };
+	uint8_t rx[96] = { 0 };
+	tx[0] = (uint8_t)(addr & 0x7f);
+	IOReturn ret = fSPI->spiTransfer(tx, rx, len + 2, NVT_SPI_HZ, 0, 0, 8);
+	if (ret != kIOReturnSuccess) {
+		return false;
+	}
+	/* Command echo + one turnaround byte precede the data. */
+	for (uint32_t i = 0; i < len; i++) {
+		buf[i] = rx[i + 2];
+	}
+	return true;
+}
+
+bool
+SweetNovatekTouch::readFwInfo()
+{
+	uint8_t info[40] = { 0 };
+	if (!readData(NVT_EVENT_BUF | NVT_EVENT_FWINFO, info, 39)) {
+		return false;
+	}
+	fFwVer = info[0];
+	fMaxX = (uint32_t)info[4] << 8 | info[5];
+	fMaxY = (uint32_t)info[6] << 8 | info[7];
+	if (fMaxX == 0 || fMaxX > 4095) {
+		fMaxX = 1600;
+	}
+	if (fMaxY == 0 || fMaxY > 4095) {
+		fMaxY = 2560;
+	}
+	IOLog("SWEET NVT: fw=%u xmax=%u ymax=%u xnum=%u ynum=%u sum=%02x\n",
+	    fFwVer, fMaxX, fMaxY, info[2], info[3],
+	    (unsigned)(info[0] + info[1]) & 0xff);
+	if ((uint8_t)(info[0] + info[1]) != 0xff) {
+		IOLog("SWEET NVT: FWINFO checksum bytes do not sum to 0xff\n");
+	}
+	return true;
+}
+
+void
+SweetNovatekTouch::pollFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetNovatekTouch *self = (SweetNovatekTouch *)owner;
+	self->poll();
+	sender->setTimeoutMS(8);
+}
+
+void
+SweetNovatekTouch::poll()
+{
+	if (fSPI == NULL || fTLMM == NULL) {
+		return;
+	}
+	bool asserted = fForcePoll || fTLMM->gpioRead(NVT_IRQ_GPIO);
+	if (asserted) {
+		readPacket();
+	}
+}
+
+void
+SweetNovatekTouch::reportSlot(uint32_t slot, bool down, uint32_t x, uint32_t y)
+{
+	sweet_hid_touch((int)slot, down ? 1 : 0, (int)x, (int)y);
+}
+
+void
+SweetNovatekTouch::readPacket()
+{
+	uint8_t d[NVT_PACKET_LEN] = { 0 };
+	if (!readData(NVT_EVENT_BUF, d, NVT_PACKET_LEN)) {
+		if (++fErrors < 4) {
+			IOLog("SWEET NVT: packet read error %u\n", fErrors);
+		}
+		return;
+	}
+	uint8_t sum = 0;
+	for (uint32_t i = 0; i < 64; i++) {
+		sum += d[i];
+	}
+	if ((uint8_t)(~sum + 1) != d[64]) {
+		if (++fChecksumErrors < 4) {
+			IOLog("SWEET NVT: packet checksum %02x != %02x\n",
+			    (unsigned)(uint8_t)(~sum + 1), d[64]);
+		}
+		return;
+	}
+
+	bool present[NVT_MAX_FINGERS] = { false };
+	uint32_t px[NVT_MAX_FINGERS] = { 0 };
+	uint32_t py[NVT_MAX_FINGERS] = { 0 };
+	for (uint32_t i = 0; i < NVT_MAX_FINGERS; i++) {
+		uint32_t p = i * 6;
+		uint8_t id = d[p] >> 3;
+		uint8_t st = d[p] & 0x7;
+		if (id == 0 || id > NVT_MAX_FINGERS) {
+			continue;
+		}
+		if (st != 1 && st != 2) {
+			continue;
+		}
+		uint32_t x = (uint32_t)d[p + 1] << 4 | (d[p + 3] >> 4);
+		uint32_t y = (uint32_t)d[p + 2] << 4 | (d[p + 3] & 0xf);
+		if (x > fMaxX || y > fMaxY) {
+			continue;
+		}
+		present[i] = true;
+		px[i] = x;
+		py[i] = y;
+	}
+
+	IOLockLock(fLock);
+	for (uint32_t i = 0; i < NVT_MAX_FINGERS; i++) {
+		if (present[i]) {
+			if (!fDown[i] || fX[i] != px[i] || fY[i] != py[i]) {
+				fDown[i] = true;
+				fX[i] = px[i];
+				fY[i] = py[i];
+				reportSlot(i, true, px[i], py[i]);
+			}
+		} else if (fDown[i]) {
+			fDown[i] = false;
+			reportSlot(i, false, fX[i], fY[i]);
+		}
+	}
+	IOLockUnlock(fLock);
+	if (++fPackets == 1 || (fPackets % 2000) == 0) {
+		IOLog("SWEET NVT: %u packets, %u errors, %u checksum errors\n",
+		    fPackets, fErrors, fChecksumErrors);
+	}
+}
+
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetNovatekTouch.h b/iokit/Kernel/arm/SweetNovatekTouch.h
