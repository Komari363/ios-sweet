@@ -0,0 +1,53 @@
+/*
+ * NABU NT36523 touch provider (SPI, SE18).
+ *
+ * The controller already runs its factory firmware; A4.2 deliberately does
+ * not download a firmware image.  This provider reads the event buffer and
+ * feeds the existing SweetHIDTouch service through sweet_hid_touch().
+ */
+#ifndef _SWEET_NOVATEK_TOUCH_H
+#define _SWEET_NOVATEK_TOUCH_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOLocks.h>
+
+class IOWorkLoop;
+class IOTimerEventSource;
+class SweetGeniSPI;
+class SweetTLMM;
+
+class SweetNovatekTouch : public IOService {
+	OSDeclareDefaultStructors(SweetNovatekTouch);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+private:
+	static void pollFired(OSObject *owner, IOTimerEventSource *sender);
+	bool findProviders();
+	bool pageSet(uint32_t addr);
+	bool readData(uint32_t addr, uint8_t *buf, uint32_t len);
+	bool readFwInfo();
+	void poll();
+	void readPacket();
+	void reportSlot(uint32_t slot, bool down, uint32_t x, uint32_t y);
+
+	SweetGeniSPI *fSPI;
+	SweetTLMM *fTLMM;
+	IOWorkLoop *fWorkLoop;
+	IOTimerEventSource *fTimer;
+	IOLock *fLock;
+	uint32_t fMaxX;
+	uint32_t fMaxY;
+	uint32_t fFwVer;
+	uint32_t fPackets;
+	uint32_t fErrors;
+	uint32_t fChecksumErrors;
+	bool fDown[10];
+	uint32_t fX[10];
+	uint32_t fY[10];
+	bool fForcePoll;
+};
+
+#endif /* _SWEET_NOVATEK_TOUCH_H */
