+bool
+SweetTLMM::gpioReadOutput(uint32_t pin)
+{
+	uint32_t reg = pinControl(pin);
+	if (fBase == NULL || reg == 0) {
+		return false;
+	}
+	return (fBase[(reg + 4) / 4] & (1u << 1)) != 0;
