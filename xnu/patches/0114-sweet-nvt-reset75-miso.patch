+bool
+SweetNovatekTouch::nvtSampleMiso(const char *tag)
+{
+	if (fTLMM == NULL) {
+		return false;
+	}
+	/* Sample the MISO pad as GPIO with no pull, then with a pull-up.  A
+	 * floating net reads 1 with the pull-up; a net held low or driven low
+	 * reads 0 both times. */
+	fTLMM->setMux(25, 0);
+	fTLMM->setPad(25, 0, 0, false);
+	IODelay(1000);
+	bool input = fTLMM->gpioRead(25);
+	fTLMM->setPad(25, 3, 0, false);
+	IODelay(1000);
+	bool pullup = fTLMM->gpioRead(25);
+	IOLog("SWEET NVT: MISO %s gpio25=%u pullup=%u irq39=%u\n",
+	    tag, input, pullup, fTLMM->gpioRead(39));
+	fTLMM->setMux(25, 3);
+	fTLMM->setPad(25, 0, 3, false);
+	return input;
+}
+
+bool
+SweetNovatekTouch::nvtReset75Pulse()
+{
+	if (fTLMM == NULL) {
+		return false;
+	}
+	/* DTS has novatek,reset-gpio commented out, but GPIO75 is the only
+	 * candidate reset line.  Pulse it low/high and leave it pulled up. */
+	fTLMM->setMux(75, 0);
+	fTLMM->setPad(75, 3, 0, false);
+	IODelay(1000);
+	IOLog("SWEET NVT: reset75 idle=%u\n", fTLMM->gpioRead(75));
+	fTLMM->setPad(75, 0, 3, true);
+	fTLMM->gpioWrite(75, false);
+	IODelay(10000);
+	fTLMM->gpioWrite(75, true);
+	IODelay(10000);
+	fTLMM->setMux(75, 0);
+	fTLMM->setPad(75, 3, 0, false);
+	IOLog("SWEET NVT: reset75 pulse done in=%u\n", fTLMM->gpioRead(75));
+	return true;
+}
