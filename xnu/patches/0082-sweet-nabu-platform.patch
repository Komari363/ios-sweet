diff --git a/iokit/Kernel/arm/SweetPlatform.cpp b/iokit/Kernel/arm/SweetPlatform.cpp
new file mode 100644
index 0000000..907f547
--- /dev/null
+++ b/iokit/Kernel/arm/SweetPlatform.cpp
@@ -0,0 +1,414 @@
+/*
+ * SM8150 platform providers for NABU A4.2.
+ *
+ * Linux behaviour was used only as a reference for register offsets and
+ * ordering; this implementation is original IOKit code.  The three classes
+ * are intentionally narrow and are expected to grow into real providers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+
+#include "SweetPlatform.h"
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOTypes.h>
+#include <IOKit/IOMapTypes.h>
+
+#define SWEET_TLMM_EAST          0x00500000u
+#define SWEET_TLMM_NORTH         0x00900000u
+#define SWEET_TLMM_SOUTH         0x00000000u
+#define SWEET_TLMM_PIN_STRIDE    0x1000u
+#define SWEET_TLMM_MUX_MASK      0x0000003cu
+#define SWEET_TLMM_MUX_SHIFT     2
+#define SWEET_TLMM_PULL_MASK     0x00000003u
+#define SWEET_TLMM_DRIVE_MASK    0x000001c0u
+#define SWEET_TLMM_DRIVE_SHIFT   6
+#define SWEET_TLMM_OE            (1u << 9)
+
+#define SWEET_GCC_SE18_ENABLE    0x00052014u
+#define SWEET_GCC_SE18_ENABLE_BIT 5
+#define SWEET_GCC_SE18_HALT      0x0001e274u
+#define SWEET_GCC_QUPV3_WRAP2_BCR 0x0001e000u
+
+#define SWEET_CMDD_BASE          0x00000008u
+#define SWEET_CMDD_RSC_SIZE      16u
+#define SWEET_CMDD_RSC_COUNT     8u
+#define SWEET_CMDD_HEADER        0x90u
+#define SWEET_CMDD_ENTRY_SIZE    24u
+#define SWEET_CMDD_MAGIC         0x0c0330dbu
+
+static inline uint16_t
+sweet_read16(const volatile uint8_t *p)
+{
+	return (uint16_t)p[0] | (uint16_t)p[1] << 8;
+}
+
+static inline uint32_t
+sweet_read32(const volatile uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+	    (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline uint64_t
+sweet_read64(const volatile uint8_t *p)
+{
+	uint64_t v = 0;
+	for (int i = 7; i >= 0; i--) {
+		v = (v << 8) | p[i];
+	}
+	return v;
+}
+
+/* ------------------------------------------------------------------ TLMM */
+
+OSDefineMetaClassAndStructors(SweetTLMM, IOService);
+
+bool
+SweetTLMM::init()
+{
+	if (!OSObject::init()) {
+		return false;
+	}
+	fMap = NULL;
+	fBase = NULL;
+	return true;
+}
+
+bool
+SweetTLMM::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fMap = provider->mapDeviceMemoryWithIndex(0);
+	if (fMap == NULL || fMap->getLength() < 0x1000) {
+		IOLog("SWEET TLMM: no register window\n");
+		return false;
+	}
+	fBase = (volatile uint32_t *)fMap->getVirtualAddress();
+	registerService();
+	IOLog("SWEET TLMM: pinctrl window %lu bytes\n",
+	    (unsigned long)fMap->getLength());
+	return true;
+}
+
+void
+SweetTLMM::stop(IOService *provider)
+{
+	if (fMap != NULL) {
+		fMap->release();
+		fMap = NULL;
+	}
+	fBase = NULL;
+	IOService::stop(provider);
+}
+
+uint32_t
+SweetTLMM::pinControl(uint32_t pin) const
+{
+	/* P0 windows only: SE18 (23-26), touch IRQ (39), VDDIO (100),
+	 * panel ENP/ENN (114/115).  Other pins are added with their consumers. */
+	if (pin >= 23 && pin <= 26) {
+		return SWEET_TLMM_EAST + SWEET_TLMM_PIN_STRIDE * pin;
+	}
+	if (pin == 39) {
+		return SWEET_TLMM_NORTH + SWEET_TLMM_PIN_STRIDE * pin;
+	}
+	if (pin == 100 || pin == 114 || pin == 115) {
+		return SWEET_TLMM_SOUTH + SWEET_TLMM_PIN_STRIDE * pin;
+	}
+	return 0;
+}
+
+IOReturn
+SweetTLMM::setMux(uint32_t pin, uint32_t func)
+{
+	uint32_t reg = pinControl(pin);
+	if (fBase == NULL || reg == 0) {
+		return kIOReturnUnsupported;
+	}
+	uint32_t v = fBase[reg / 4];
+	v &= ~SWEET_TLMM_MUX_MASK;
+	v |= (func & 0xf) << SWEET_TLMM_MUX_SHIFT;
+	fBase[reg / 4] = v;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetTLMM::setPad(uint32_t pin, uint32_t pull, uint32_t drive, bool output)
+{
+	uint32_t reg = pinControl(pin);
+	if (fBase == NULL || reg == 0) {
+		return kIOReturnUnsupported;
+	}
+	uint32_t v = fBase[reg / 4];
+	v &= ~(SWEET_TLMM_PULL_MASK | SWEET_TLMM_DRIVE_MASK | SWEET_TLMM_OE);
+	v |= (pull & 0x3u);
+	v |= (drive & 0x7u) << SWEET_TLMM_DRIVE_SHIFT;
+	if (output) {
+		v |= SWEET_TLMM_OE;
+	}
+	fBase[reg / 4] = v;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetTLMM::gpioWrite(uint32_t pin, bool value)
+{
+	uint32_t reg = pinControl(pin);
+	if (fBase == NULL || reg == 0) {
+		return kIOReturnUnsupported;
+	}
+	uint32_t ctl = fBase[reg / 4];
+	ctl |= SWEET_TLMM_OE;
+	fBase[reg / 4] = ctl;
+	uint32_t io = fBase[(reg + 4) / 4];
+	if (value) {
+		io |= 1u << 1;
+	} else {
+		io &= ~(1u << 1);
+	}
+	fBase[(reg + 4) / 4] = io;
+	return kIOReturnSuccess;
+}
+
+bool
+SweetTLMM::gpioRead(uint32_t pin)
+{
+	uint32_t reg = pinControl(pin);
+	if (fBase == NULL || reg == 0) {
+		return false;
+	}
+	return (fBase[(reg + 4) / 4] & 1u) != 0;
+}
+
+/* ------------------------------------------------------------------- GCC */
+
+OSDefineMetaClassAndStructors(SweetGCC, IOService);
+
+bool
+SweetGCC::init()
+{
+	if (!OSObject::init()) {
+		return false;
+	}
+	fMap = NULL;
+	fBase = NULL;
+	return true;
+}
+
+bool
+SweetGCC::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fMap = provider->mapDeviceMemoryWithIndex(0);
+	if (fMap == NULL || fMap->getLength() < 0x200000) {
+		IOLog("SWEET GCC: no register window\n");
+		return false;
+	}
+	fBase = (volatile uint32_t *)fMap->getVirtualAddress();
+	registerService();
+	IOLog("SWEET GCC: window %lu bytes, SE18 enable=0x%x\n",
+	    (unsigned long)fMap->getLength(), fBase[SWEET_GCC_SE18_ENABLE / 4]);
+	return true;
+}
+
+void
+SweetGCC::stop(IOService *provider)
+{
+	if (fMap != NULL) {
+		fMap->release();
+		fMap = NULL;
+	}
+	fBase = NULL;
+	IOService::stop(provider);
+}
+
+uint32_t
+SweetGCC::read32(uint32_t off) const
+{
+	if (fBase == NULL || off >= 0x1f0000u || (off & 3u)) {
+		return 0;
+	}
+	return fBase[off / 4];
+}
+
+void
+SweetGCC::write32(uint32_t off, uint32_t value)
+{
+	if (fBase != NULL && off < 0x1f0000u && !(off & 3u)) {
+		fBase[off / 4] = value;
+	}
+}
+
+IOReturn
+SweetGCC::enableSE(uint32_t se)
+{
+	if (fBase == NULL) {
+		return kIOReturnNotReady;
+	}
+	if (se != 18) {
+		return kIOReturnUnsupported;
+	}
+	uint32_t v = fBase[SWEET_GCC_SE18_ENABLE / 4];
+	v |= 1u << SWEET_GCC_SE18_ENABLE_BIT;
+	fBase[SWEET_GCC_SE18_ENABLE / 4] = v;
+	/* BRANCH_HALT_VOTED: bit 31 clears when the branch is on. */
+	for (int i = 0; i < 1000; i++) {
+		if (!(fBase[SWEET_GCC_SE18_HALT / 4] & (1u << 31))) {
+			IOLog("SWEET GCC: SE18 branch on after %d us\n", i * 10);
+			return kIOReturnSuccess;
+		}
+		IODelay(10);
+	}
+	IOLog("SWEET GCC: SE18 branch did not halt-clear (halt=0x%x)\n",
+	    fBase[SWEET_GCC_SE18_HALT / 4]);
+	return kIOReturnTimeout;
+}
+
+IOReturn
+SweetGCC::resetSE(uint32_t se)
+{
+	if (fBase == NULL) {
+		return kIOReturnNotReady;
+	}
+	if (se != 18) {
+		return kIOReturnUnsupported;
+	}
+	/* GCC QUPv3 wrapper BCR: bit 0 asserts the block reset. */
+	fBase[SWEET_GCC_QUPV3_WRAP2_BCR / 4] = 1;
+	IODelay(100);
+	fBase[SWEET_GCC_QUPV3_WRAP2_BCR / 4] = 0;
+	IOLog("SWEET GCC: SE18 wrapper reset released\n");
+	return kIOReturnSuccess;
+}
+
+/* ---------------------------------------------------------------- CmdDb */
+
+OSDefineMetaClassAndStructors(SweetCmdDb, IOService);
+
+bool
+SweetCmdDb::init()
+{
+	if (!OSObject::init()) {
+		return false;
+	}
+	fWindow = NULL;
+	fDbMap = NULL;
+	fDb = NULL;
+	fDbSize = 0;
+	fMagic = 0;
+	return true;
+}
+
+bool
+SweetCmdDb::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fWindow = provider->mapDeviceMemoryWithIndex(0);
+	if (fWindow == NULL || fWindow->getLength() < 8) {
+		IOLog("SWEET CMDDB: no dictionary pointer window\n");
+		return false;
+	}
+	volatile uint8_t *win = (volatile uint8_t *)fWindow->getVirtualAddress();
+	if (win == NULL) {
+		IOLog("SWEET CMDDB: no virtual window\n");
+		fWindow->release();
+		fWindow = NULL;
+		return false;
+	}
+	uint32_t start = sweet_read32(win);
+	uint32_t size = sweet_read32(win + 4);
+	if (start == 0 || size < SWEET_CMDD_HEADER || size > (1u << 20)) {
+		IOLog("SWEET CMDDB: bad dictionary %u/0x%x\n", start, size);
+		return false;
+	}
+	IOMemoryDescriptor *desc = IOMemoryDescriptor::withPhysicalAddress(
+	    (IOPhysicalAddress)start, size, kIODirectionIn);
+	if (desc == NULL) {
+		IOLog("SWEET CMDDB: cannot describe 0x%x+0x%x\n", start, size);
+		return false;
+	}
+	fDbMap = desc->map(kIOMapDefaultCache);
+	desc->release();
+	if (fDbMap == NULL) {
+		IOLog("SWEET CMDDB: cannot map 0x%x+0x%x\n", start, size);
+		return false;
+	}
+	fDb = (volatile uint8_t *)fDbMap->getVirtualAddress();
+	fDbSize = size;
+	fMagic = sweet_read32(fDb + 4);
+	registerService();
+	IOLog("SWEET CMDDB: 0x%x+0x%x magic=0x%x version=0x%x\n",
+	    start, size, fMagic, sweet_read32(fDb));
+	if (fMagic != SWEET_CMDD_MAGIC) {
+		IOLog("SWEET CMDDB: bad magic (want 0x%x)\n", SWEET_CMDD_MAGIC);
+		return false;
+	}
+	return true;
+}
+
+void
+SweetCmdDb::stop(IOService *provider)
+{
+	if (fDbMap != NULL) {
+		fDbMap->release();
+		fDbMap = NULL;
+	}
+	if (fWindow != NULL) {
+		fWindow->release();
+		fWindow = NULL;
+	}
+	fDb = NULL;
+	fDbSize = 0;
+	IOService::stop(provider);
+}
+
+bool
+SweetCmdDb::lookup(const char *resource, uint32_t *addr, uint16_t *len,
+    uint16_t *version)
+{
+	if (fDb == NULL || resource == NULL || addr == NULL ||
+	    fDbSize < SWEET_CMDD_HEADER) {
+		return false;
+	}
+	uint64_t id = 0;
+	for (unsigned int i = 0; i < 8 && resource[i] != '\0'; i++) {
+		((uint8_t *)&id)[i] = (uint8_t)resource[i];
+	}
+	for (uint32_t r = 0; r < SWEET_CMDD_RSC_COUNT; r++) {
+		const volatile uint8_t *rh = fDb + SWEET_CMDD_BASE +
+		    r * SWEET_CMDD_RSC_SIZE;
+		uint16_t slv = sweet_read16(rh);
+		if (slv == 0) {
+			break;
+		}
+		uint16_t hdr = sweet_read16(rh + 2);
+		uint16_t cnt = sweet_read16(rh + 6);
+		uint32_t off = SWEET_CMDD_HEADER + hdr;
+		if (off > fDbSize) {
+			break;
+		}
+		for (uint32_t j = 0; j < cnt; j++) {
+			uint32_t eoff = off + j * SWEET_CMDD_ENTRY_SIZE;
+			if (eoff + SWEET_CMDD_ENTRY_SIZE > fDbSize) {
+				break;
+			}
+			const volatile uint8_t *e = fDb + eoff;
+			if (sweet_read64(e) != id) {
+				continue;
+			}
+			*addr = sweet_read32(e + 16);
+			if (len != NULL) {
+				*len = sweet_read16(e + 20);
+			}
+			if (version != NULL) {
+				*version = sweet_read16(rh + 8);
+			}
+			return true;
+		}
+	}
+	return false;
+}
+
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetPlatform.h b/iokit/Kernel/arm/SweetPlatform.h
new file mode 100644
index 0000000..bd586c4
--- /dev/null
+++ b/iokit/Kernel/arm/SweetPlatform.h
@@ -0,0 +1,74 @@
+/*
+ * Minimal SM8150 platform providers for the A4.2 NABU bring-up.
+ *
+ * These are deliberately small: SweetTLMM only owns the P0 pin windows,
+ * SweetGCC only the SE18 branch/reset, and SweetCmdDb only the resource
+ * lookup table.  Full pinctrl/clk frameworks are A8 work.
+ */
+#ifndef _SWEET_PLATFORM_H
+#define _SWEET_PLATFORM_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+class SweetTLMM : public IOService {
+	OSDeclareDefaultStructors(SweetTLMM);
+
+public:
+	bool init() APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	/* raw mux index (0 = GPIO, board-specific values otherwise) */
+	IOReturn setMux(uint32_t pin, uint32_t func);
+	/* pull: 0=none, 1=down, 2=keeper, 3=up; drive: 0..7 */
+	IOReturn setPad(uint32_t pin, uint32_t pull, uint32_t drive, bool output);
+	IOReturn gpioWrite(uint32_t pin, bool value);
+	bool gpioRead(uint32_t pin);
+
+private:
+	IOMemoryMap *fMap;
+	volatile uint32_t *fBase;
+	uint32_t pinControl(uint32_t pin) const;
+};
+
+class SweetGCC : public IOService {
+	OSDeclareDefaultStructors(SweetGCC);
+
+public:
+	bool init() APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	/* A4.2 only needs the QUPv3 SE18 branch; other IDs are rejected. */
+	IOReturn enableSE(uint32_t se);
+	IOReturn resetSE(uint32_t se);
+	uint32_t read32(uint32_t off) const;
+	void write32(uint32_t off, uint32_t value);
+
+private:
+	IOMemoryMap *fMap;
+	volatile uint32_t *fBase;
+};
+
+class SweetCmdDb : public IOService {
+	OSDeclareDefaultStructors(SweetCmdDb);
+
+public:
+	bool init() APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	/* Resource ID -> RPMh TCS address, aux length and RSC version. */
+	bool lookup(const char *resource, uint32_t *addr, uint16_t *len,
+	    uint16_t *version);
+
+private:
+	IOMemoryMap *fWindow;
+	IOMemoryMap *fDbMap;
+	volatile uint8_t *fDb;
+	uint32_t fDbSize;
+	uint32_t fMagic;
+};
+
+#endif /* _SWEET_PLATFORM_H */
