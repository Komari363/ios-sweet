+/*
+ * Diagnostic-only boot/routing probe.  SWEET has no PE_halt_restart hook,
+ * so install a temporary PSCI SYSTEM_RESET hook and drive the ordinary
+ * reboot_kernel() path.  This runs before HFS+ mount and writes nothing.
+ */
+extern int (*PE_halt_restart)(unsigned int type);
+
+static void __attribute__((noreturn))
+sweet_boot_probe_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL; /* PSCI SYSTEM_RESET */
+
+	__asm__ volatile("smc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	for (;;) {
+		;
+	}
+}
+
+static int
+sweet_boot_probe_halt_restart(__unused unsigned int type)
+{
+	sweet_boot_probe_reset();
+	return -1;
+}
+
 static int
 sweet_ufs_init(void)
 {
@@ -666,6 +694,17 @@
 		    sweetpanic);
 		panic("SWEET-PANIC-PROBE");
 	}
+	int sweetboot = 0;
