+		printf("SWEET BOOT PROBE: sweetboot=%d, reboot_kernel before root mount\n",
+		    sweetboot);
+		PE_halt_restart = &sweet_boot_probe_halt_restart;
+		delay(1000000);
+		rc = reboot_kernel(RB_QUICK | RB_NOSYNC, NULL);
+		panic("SWEET-BOOT-PROBE: reboot_kernel returned %d", rc);
+	}
