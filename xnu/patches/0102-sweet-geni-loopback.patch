+IOReturn
+SweetGeniSPI::loopbackTest()
+{
+	const uint8_t tx[4] = { 0xa5, 0x5a, 0x00, 0xff };
+	uint8_t rx[4] = { 0 };
+
+	fLoopback = true;
+	IOReturn ret = spiTransfer(tx, rx, sizeof(tx), 9600000, 0, 0, 8);
+	uint32_t loop = readReg(SPI_LOOPBACK);
+	fLoopback = false;
+	writeReg(SPI_LOOPBACK, 0);
+	IOLog("SWEET SPI: loopback ret=0x%x tx=%02x%02x%02x%02x rx=%02x%02x%02x%02x rxfifo=0x%x mirq=0x%x geni=0x%x loop=0x%x\n",
+	    (unsigned)ret, tx[0], tx[1], tx[2], tx[3],
+	    rx[0], rx[1], rx[2], rx[3],
+	    (unsigned)readReg(GENI_RX_FIFO_STATUS),
+	    (unsigned)readReg(GENI_M_IRQ_STATUS),
+	    (unsigned)readReg(GENI_STATUS),
+	    (unsigned)loop);
+	return ret;
+}
