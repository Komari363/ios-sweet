@@ -323,6 +324,21 @@
 	if (gcc == NULL) {
 		return false;
 	}
+	/*
+	 * Route21: reset the QUPv3 wrap2 block once before the first SE18
+	 * enable.  SweetGCC::resetSE() existed but was never called; route20
+	 * showed that bypassing the S_AHB halt was not sufficient for
+	 * M_CMD_DONE.  A wrapper reset clears any bootloader-left sequencer
+	 * state and the S_AHB branch before the first command.
+	 */
+	if (!fSEResetDone) {
+		IOReturn rr = gcc->resetSE(18);
+		if (rr != kIOReturnSuccess) {
+			IOLog("SWEET SPI: SE18 wrapper reset failed 0x%x\n", rr);
+			return false;
+		}
+		fSEResetDone = true;
+	}
 	IOReturn ret = gcc->enableSE(18);
 	if (ret != kIOReturnSuccess) {
 		IOLog("SWEET SPI: SE18 clock enable failed 0x%x\n", ret);
