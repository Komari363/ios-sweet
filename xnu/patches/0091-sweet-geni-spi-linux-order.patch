+				IOLog("SWEET SPI: cmd timeout len=%u status=0x%x irq=0x%x en=0x%x ctrl=0x%x mcmd=0x%x txfifo=0x%x rxfifo=0x%x twm=0x%x\n",
 				    len, readReg(GENI_STATUS), readReg(GENI_M_IRQ_STATUS),
