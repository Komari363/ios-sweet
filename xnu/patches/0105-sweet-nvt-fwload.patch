+bool
+SweetNovatekTouch::writeBuffer(uint32_t addr, const uint8_t *data, uint32_t len)
+{
+	if (len == 0) {
+		return true;
+	}
+	if (data == NULL) {
+		return false;
+	}
+	uint8_t *tx = (uint8_t *)IOMalloc(NVT_FW_CHUNK + 1);
+	if (tx == NULL) {
+		return false;
+	}
+	bool ok = true;
+	for (uint32_t off = 0; off < len; off += NVT_FW_CHUNK) {
+		uint32_t chunk = len - off;
+		if (chunk > NVT_FW_CHUNK) {
+			chunk = NVT_FW_CHUNK;
+		}
+		if (!pageSet(addr + off)) {
+			ok = false;
+			break;
+		}
+		tx[0] = (uint8_t)((addr + off) & 0x7fu) | 0x80u;
+		memcpy(tx + 1, data + off, chunk);
+		if (fSPI->spiTransfer(tx, NULL, chunk + 1, NVT_SPI_HZ, 0, 0, 8) !=
+		    kIOReturnSuccess) {
+			ok = false;
+			break;
+		}
+	}
+	IOFree(tx, NVT_FW_CHUNK + 1);
+	return ok;
+}
+
+bool
+SweetNovatekTouch::nvtSetBldHwCrc()
+{
+	static const uint32_t desAddr[2] = { 0x03f128u, 0x03f12cu };
+	static const uint32_t lenAddr[2] = { 0x03f118u, 0x03f130u };
+	static const uint32_t crcAddr[2] = { 0x03f100u, 0x03f104u };
+	for (uint32_t i = 0; i < 2; i++) {
+		uint32_t sram = kNvtFwParts[i].sram;
+		uint32_t size = kNvtFwParts[i].size;
+		uint32_t crc = kNvtFwParts[i].crc;
+		uint8_t des[3] = {
+			(uint8_t)(sram & 0xffu),
+			(uint8_t)((sram >> 8) & 0xffu),
+			(uint8_t)((sram >> 16) & 0xffu)
+		};
+		uint8_t lenb[3] = {
+			(uint8_t)(size & 0xffu),
+			(uint8_t)((size >> 8) & 0xffu),
+			(uint8_t)((size >> 16) & 0x01u)
+		};
+		uint8_t crcb[4] = {
+			(uint8_t)(crc & 0xffu),
+			(uint8_t)((crc >> 8) & 0xffu),
+			(uint8_t)((crc >> 16) & 0xffu),
+			(uint8_t)((crc >> 24) & 0xffu)
+		};
+		if (!writeBuffer(desAddr[i], des, sizeof(des)) ||
+		    !writeBuffer(lenAddr[i], lenb, sizeof(lenb)) ||
+		    !writeBuffer(crcAddr[i], crcb, sizeof(crcb))) {
+			IOLog("SWEET NVT: BLD CRC bank %u failed\n", i);
+			return false;
+		}
+	}
+	return true;
+}
+
+bool
+SweetNovatekTouch::nvtBldCrcEnable()
+{
+	uint8_t value = 0;
+	if (!readData(NVT_BLD_CRC_EN, &value, 1)) {
+		IOLog("SWEET NVT: BLD CRC read failed\n");
+		return false;
+	}
+	value |= 0x80u;
+	if (!writeBuffer(NVT_BLD_CRC_EN, &value, 1)) {
+		IOLog("SWEET NVT: BLD CRC enable failed\n");
+		return false;
+	}
+	return true;
+}
+
+bool
+SweetNovatekTouch::nvtFwCrcEnable()
+{
+	uint8_t zero = 0;
+	uint8_t cmd = 0xaeu;
+	if (!writeBuffer(NVT_RESET_STATE, &zero, 1) ||
+	    !writeBuffer(NVT_EVENT_BUF | NVT_EVENT_HANDSHAKE, &cmd, 1)) {
+		IOLog("SWEET NVT: FW CRC enable failed\n");
+		return false;
+	}
+	return true;
+}
+
+bool
+SweetNovatekTouch::nvtBootReady()
+{
+	uint8_t one = 1;
+	if (!writeBuffer(NVT_BOOT_RDY, &one, 1)) {
+		IOLog("SWEET NVT: boot ready write failed\n");
+		return false;
+	}
+	IODelay(5000);
+	return true;
+}
+
+bool
+SweetNovatekTouch::nvtCheckResetState(uint8_t state)
+{
+	uint8_t info[6] = { 0 };
+	for (uint32_t i = 0; i < 10; i++) {
+		if (readData(NVT_RESET_STATE, info, sizeof(info))) {
+			if (info[1] >= state && info[1] <= 0xafu) {
+				return true;
+			}
+		}
+		IODelay(10000);
+	}
+	IOLog("SWEET NVT: reset state %02x not reached (last %02x)\n",
+	    (unsigned)state, (unsigned)info[1]);
+	return false;
+}
+
+bool
+SweetNovatekTouch::loadFirmwareBlob(const void *data, uint32_t len)
+{
+	const uint8_t *fw = (const uint8_t *)data;
+	if (fw == NULL || len < 0x400) {
+		IOLog("SWEET NVT: firmware blob too small\n");
+		return false;
+	}
+	if (memcmp(fw + len - 3, "NVT", 3) != 0) {
+		IOLog("SWEET NVT: firmware end flag missing\n");
+		return false;
+	}
+	if (!nvtBootloaderReset()) {
+		IOLog("SWEET NVT: firmware bootloader reset failed\n");
+		return false;
+	}
+	if (!nvtSetBldHwCrc()) {
+		return false;
+	}
+	for (uint32_t i = 0; i < sizeof(kNvtFwParts) / sizeof(kNvtFwParts[0]); i++) {
+		uint32_t size = kNvtFwParts[i].size;
+		if (size == 0) {
+			continue;
+		}
+		if (kNvtFwParts[i].bin + size + 1 > len) {
+			IOLog("SWEET NVT: firmware part %u out of range\n", i);
+			return false;
+		}
+		if (!writeBuffer(kNvtFwParts[i].sram,
+		    fw + kNvtFwParts[i].bin, size + 1)) {
+			IOLog("SWEET NVT: firmware part %u write failed\n", i);
+			return false;
+		}
+		IOLog("SWEET NVT: firmware part %u written %u\n", i, size + 1);
+	}
+	if (!nvtBldCrcEnable() || !nvtFwCrcEnable() || !nvtBootReady()) {
+		return false;
+	}
+	if (!nvtCheckResetState(0xa0u)) {
+		return false;
+	}
+	return true;
+}
