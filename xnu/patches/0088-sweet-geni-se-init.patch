+/*
+ * Mirror geni_se_init()/se_io_init()/se_io_set_mode() for a polled FIFO
+ * engine, plus the 8-bit packing used by the working SE7 I2C driver.
+ * Without this the sequencer inherits ABL's setup: packing is not four
+ * bytes per FIFO entry, byte granularity is not selected, and the GENI
+ * core is not forced to its default IO/output state.
+ *
+ * SE_IRQ_EN is deliberately cleared: this driver polls the local
+ * M_IRQ_STATUS and the SE18 GIC SPI is not wired during bring-up.
+ */
+bool
+SweetGeniSPI::configureSE()
+{
+	if (fSEReady) {
+		return true;
+	}
+	if (fBase == NULL) {
+		return false;
+	}
+	if (readReg(GENI_IF_FIFO_DISABLE) & 1u) {
+		IOLog("SWEET SPI: SE18 FIFO interface disabled (GSI mode)\n");
+		return false;
+	}
+	for (uint32_t i = 0; i < 100; i++) {
+		if (!(readReg(GENI_STATUS) & 1u)) {
+			break;
+		}
+		IODelay(10);
+	}
+	if (readReg(GENI_STATUS) & 1u) {
+		IOLog("SWEET SPI: SE18 command still active status=0x%x\n",
+		    readReg(GENI_STATUS));
+		return false;
+	}
+
+	writeReg(GENI_GSI_EVENT_EN, 0);
+	writeReg(GENI_IRQ_EN, 0);              /* no external GIC routing */
+	writeReg(SPI_S_IRQ_EN, 0);
+	writeReg(GENI_S_IRQ_CLEAR, 0xffffffffu);
+	writeReg(GENI_M_IRQ_CLEAR, 0xffffffffu);
+	writeReg(GENI_DMA_MODE_EN, 0);         /* FIFO mode */
+	writeReg(GENI_CGC_CTRL, readReg(GENI_CGC_CTRL) | 0x7fu);
+	writeReg(GENI_DMA_GENERAL_CFG,
+	    readReg(GENI_DMA_GENERAL_CFG) | 0x0fu);
+	writeReg(GENI_OUTPUT_CTRL, 0x7fu);
+	writeReg(GENI_FORCE_DEFAULT_REG, 1);
+	writeReg(GENI_BYTE_GRAN, 0);
+	writeReg(GENI_TX_PACKING_CFG0, SPI_PACK0);
+	writeReg(GENI_TX_PACKING_CFG1, SPI_PACK1);
+	writeReg(GENI_RX_PACKING_CFG0, SPI_PACK0);
+	writeReg(GENI_RX_PACKING_CFG1, SPI_PACK1);
+	writeReg(GENI_RX_WATERMARK, 0);
+	writeReg(GENI_RX_RFR_WATERMARK,
+	    fRxDepth > 2 ? fRxDepth - 2 : 0);
+	writeReg(GENI_TX_WATERMARK, 0);
+
+	IOLog("SWEET SPI: SE init fw=0x%x if=0x%x cgc=0x%x out=0x%x force=0x%x gran=0x%x\n",
+	    readReg(GENI_FW_REVISION), readReg(GENI_IF_FIFO_DISABLE),
+	    readReg(GENI_CGC_CTRL), readReg(GENI_OUTPUT_CTRL),
+	    readReg(GENI_FORCE_DEFAULT_REG), readReg(GENI_BYTE_GRAN));
+	IOLog("SWEET SPI: SE init pack=0x%x/0x%x/0x%x/0x%x irqen=0x%x gsi=0x%x s_irq=0x%x rxwm=%u/%u status=0x%x\n",
+	    readReg(GENI_TX_PACKING_CFG0), readReg(GENI_TX_PACKING_CFG1),
+	    readReg(GENI_RX_PACKING_CFG0), readReg(GENI_RX_PACKING_CFG1),
+	    readReg(GENI_IRQ_EN), readReg(GENI_GSI_EVENT_EN),
+	    readReg(SPI_S_IRQ_EN), readReg(GENI_RX_WATERMARK),
+	    readReg(GENI_RX_RFR_WATERMARK), readReg(GENI_STATUS));
+
+	if (readReg(GENI_TX_PACKING_CFG0) != SPI_PACK0 ||
+	    readReg(GENI_TX_PACKING_CFG1) != SPI_PACK1 ||
+	    readReg(GENI_RX_PACKING_CFG0) != SPI_PACK0 ||
+	    readReg(GENI_RX_PACKING_CFG1) != SPI_PACK1 ||
+	    readReg(GENI_BYTE_GRAN) != 0) {
+		IOLog("SWEET SPI: SE18 packing readback mismatch\n");
+		return false;
+	}
+	fSEReady = true;
+	return true;
+}
