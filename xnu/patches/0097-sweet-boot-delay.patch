--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -607,10 +607,28 @@
 static int
 sweet_boot_probe_halt_restart(__unused unsigned int type)
 {
 	sweet_boot_probe_reset();
 	return -1;
 }
 
+static int sweet_boot_probe_delay_ms;
+
+static void
+sweet_boot_probe_delay_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int ticks = (sweet_boot_probe_delay_ms * hz) / 1000;
+
+	if (ticks <= 0) {
+		ticks = 1;
+	}
+	printf("SWEET BOOT PROBE: delayed reset in %d ms (%d ticks)\n",
+	    sweet_boot_probe_delay_ms, ticks);
+	(void)tsleep(&sweet_boot_probe_delay_ms, PZERO, "sweetboot", ticks);
+	printf("SWEET BOOT PROBE: delayed reset now\n");
+	(void)reboot_kernel(RB_QUICK | RB_NOSYNC, NULL);
+	panic("SWEET-BOOT-PROBE: delayed reboot_kernel returned");
+}
+
 static int
 sweet_ufs_init(void)
 {
@@ -697,13 +715,22 @@
 	int sweetboot = 0;
 	if (PE_parse_boot_argn("sweetboot", &sweetboot, sizeof(sweetboot)) &&
 	    sweetboot != 0) {
-		int rc;
-		printf("SWEET BOOT PROBE: sweetboot=%d, reboot_kernel before root mount\n",
-		    sweetboot);
-		PE_halt_restart = &sweet_boot_probe_halt_restart;
-		delay(1000000);
-		rc = reboot_kernel(RB_QUICK | RB_NOSYNC, NULL);
-		panic("SWEET-BOOT-PROBE: reboot_kernel returned %d", rc);
+		thread_t thread;
+
+		printf("SWEET BOOT PROBE: sweetboot=%d, delayed reset probe\n",
+		    sweetboot);
+		PE_parse_boot_argn("sweetboot_delay_ms", &sweet_boot_probe_delay_ms,
+		    sizeof(sweet_boot_probe_delay_ms));
+		if (sweet_boot_probe_delay_ms <= 0) {
+			sweet_boot_probe_delay_ms = 300000;
+		}
+		PE_halt_restart = &sweet_boot_probe_halt_restart;
+		if (kernel_thread_start(sweet_boot_probe_delay_thread, NULL,
+		    &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			panic("SWEET-BOOT-PROBE: kernel_thread_start failed");
+		}
 	}
 	sweet_log_start();
 	sweet_sample_start();
